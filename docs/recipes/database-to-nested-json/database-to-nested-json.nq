output json;
literal drop table if exists order_item;
literal drop table if exists customer_order;
literal drop table if exists address;
literal drop table if exists customer;

literal create table customer (
  id integer primary key,
  name varchar(80) not null
)
;

literal create table address (
  id integer primary key,
  customer_id integer not null,
  addr1 varchar(80), 
  addr2 varchar(80), 
  city varchar(30), 
  primary_residence char not null default 'N',
  foreign key (customer_id) references customer(id)
)
;

literal create table customer_order (
  id integer primary key,
  customer_id integer not null,
  ordered_on date not null,
  foreign key (customer_id) references customer(id)
)
;

literal create table order_item (
  id integer primary key,
  order_id integer not null,
  sku varchar(40) not null,
  quantity integer not null,
  foreign key (order_id) references customer_order(id)
)
;

literal insert into customer values
  (1, 'Alice'),
  (2, 'Bob'),
  (3, 'Yuki')
;

literal insert into address values 
  (1, 1, '21 acacia drive', null, 'Tokyo', 'Y'),
  (2, 1, '11 Downing Street', null, 'London', 'N'),
  (3, 2, '1 George Street', null, 'Sydney', 'Y')
;


literal insert into customer_order values
  (1001, 1, date '2026-07-01'),
  (1002, 1, date '2026-07-15'),
  (1003, 2, date '2026-07-20')
;

literal insert into order_item values
  (1, 1001, 'TEA', 2),
  (2, 1001, 'CAKE', 1),
  (3, 1002, 'MUG', 2),
  (4, 1003, 'COFFEE', 1)
;


select
  c.name       into {customers.customer.name},
  a.city       into {customers.customer.city} absent on null,
  o.id         into {customers.customer.orders.order.order_id},
  o.ordered_on into {customers.customer.orders.order.date},
  i.sku        into {customers.customer.orders.order.items.item.product},
  i.quantity   into {customers.customer.orders.order.items.item.qty}
from customer c
left join address a on a.customer_id = c.id and a.primary_residence = 'Y'
left join customer_order o on o.customer_id = c.id
left join order_item i on i.order_id = o.id
;

