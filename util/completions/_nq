#compdef nq

local -a commands formats inputs drivers
commands=(run convert catalog cache help version)
formats=(json jsonl yaml xml csv tsv toml markdown)
inputs=(json jsonl yaml xml csv tsv toml parquet)
drivers=(h2 mysql mariadb postgresql oracle sqlserver db2 hana informix)

_arguments -s \
  '1:command:($commands)' \
  '2:cache subcommand:(load use list clear)' \
  '-h[show brief help]' \
  '--help[show full or command-local help]' \
  '--version[show NQ version]' \
  '(-f --script-file)'{-f,--script-file}'[read script file]:file:_files' \
  '(-e --script-text)'{-e,--script-text}'[use inline script]:text:' \
  '(-i --input-file)'{-i,--input-file}'[read input file or -]:file:_files' \
  '(-t --input-format)'{-t,--input-format}'[name stdin format]:format:($inputs)' \
  '*--param[set task parameter]:name=value:' \
  '--params-file[read task parameters]:file:_files' \
  '--config[read operational configuration]:file:_files' \
  '(-o --output)'{-o,--output}'[select result format]:format:($formats)' \
  '(-r --report-format)'{-r,--report-format}'[select report format]:format:($formats)' \
  '--cache-dir[select direct cache directory]:directory:_directories' \
  '--cache[select cache execution]' \
  '(-m --pattern)'{-m,--pattern}'[select catalog pattern]:pattern:' \
  '--name[select cache name]:name:' \
  '--all[select all caches]' \
  '--older-than[select cache age]:age:' \
  '--debug[enable debug diagnostics]' \
  '--no-key-inference[disable query-output key inference]' \
  '--parquet-root[override Parquet root]:name:' \
  '--parquet-record[override Parquet record]:name:' \
  '--db[select logical database driver]:driver:($drivers)' \
  '--database[select database]:database:' \
  '--host[select host]:host:' \
  '--port[select port]:port:' \
  '--user[select username]:username:' \
  '--password[select password]:password:' \
  '--jdbc-driver[select JDBC driver]:driver:($drivers)' \
  '--jdbc-class-name[select JDBC class]:class:' \
  '--jdbc-database[select JDBC URL]:url:' \
  '--jdbc-username[select JDBC username]:username:' \
  '--jdbc-password[select JDBC password]:password:'
